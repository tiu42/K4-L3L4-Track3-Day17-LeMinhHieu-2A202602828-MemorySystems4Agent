# Copy to .env (gitignored). Offline mode needs none of this.
LAB_MODE=offline            # set to "live" to call a real LLM

# Main model: openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Judge model for --live benchmark (defaults to the main model)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_API_KEY=

# Memory knobs
COMPACT_THRESHOLD_TOKENS=1000
COMPACT_KEEP_MESSAGES=4
PROFILE_CONFIDENCE_THRESHOLD=0.6

# Live-mode extras
LIVE_MEMORY_TOOL=1          # 1 = also give the LLM the save_user_fact tool (costlier, see REPORT.md)
# LAB_STATE_DIR=state/run_a # separate state dir, e.g. for parallel benchmark runs
